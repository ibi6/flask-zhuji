{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostguard.local/schemas/telemetry-v1.json",
  "title": "HostGuard telemetry batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "collected_at", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {"type": "string", "format": "uuid"},
    "collected_at": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_percent", "memory_percent", "disk_percent", "network_bytes_sent", "network_bytes_recv"],
      "properties": {
        "cpu_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "memory_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "disk_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "network_bytes_sent": {"type": "integer", "minimum": 0},
        "network_bytes_recv": {"type": "integer", "minimum": 0}
      }
    },
    "inventory": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["hostname", "os", "os_version", "architecture", "agent_version"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1, "maxLength": 255},
        "os": {"type": "string", "enum": ["windows", "linux"]},
        "os_version": {"type": "string", "maxLength": 255},
        "architecture": {"type": "string", "maxLength": 64},
        "agent_version": {"type": "string", "maxLength": 32},
        "boot_time": {"type": ["string", "null"], "format": "date-time"},
        "ip_addresses": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 64}}
      }
    },
    "processes": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pid", "name"],
        "properties": {
          "pid": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "maxLength": 255},
          "executable": {"type": ["string", "null"], "maxLength": 1024},
          "username": {"type": ["string", "null"], "maxLength": 255},
          "started_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "listening_ports": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol", "local_address", "local_port"],
        "properties": {
          "protocol": {"type": "string", "enum": ["tcp", "udp"]},
          "local_address": {"type": "string", "maxLength": 64},
          "local_port": {"type": "integer", "minimum": 0, "maximum": 65535},
          "pid": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "occurred_at", "severity", "summary"],
        "properties": {
          "event_id": {"type": "string", "format": "uuid"},
          "event_type": {"type": "string", "maxLength": 64},
          "occurred_at": {"type": "string", "format": "date-time"},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "summary": {"type": "string", "maxLength": 1024},
          "source_ip": {"type": ["string", "null"], "maxLength": 64},
          "username": {"type": ["string", "null"], "maxLength": 255},
          "metadata": {"type": "object", "maxProperties": 32}
        }
      }
    },
    "file_changes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "path", "change_type", "occurred_at"],
        "properties": {
          "event_id": {"type": "string", "format": "uuid"},
          "path": {"type": "string", "maxLength": 2048},
          "change_type": {"type": "string", "enum": ["created", "modified", "deleted", "permission_changed"]},
          "occurred_at": {"type": "string", "format": "date-time"},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "baseline_results": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "checked_at", "message"],
        "properties": {
          "check_id": {"type": "string", "maxLength": 64},
          "status": {"type": "string", "enum": ["pass", "fail", "unavailable"]},
          "checked_at": {"type": "string", "format": "date-time"},
          "message": {"type": "string", "maxLength": 1024}
        }
      }
    }
  }
}

